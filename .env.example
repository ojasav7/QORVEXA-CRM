# ── QORVEXA CRM · environment ──────────────────────────────────────────────
# Copy to .env and fill in. For production via Docker, see docker-compose.prod.yml
# (most of these vars are forwarded there; SESSION_SECRET is mandatory).

# MongoDB connection string.
# Local (docker):  mongodb://localhost:27017/qorvexa
# Compose prod:   mongodb://mongo:27017/qorvexa?replicaSet=rs0   (set in docker-compose.prod.yml)
# MongoDB Atlas:  mongodb+srv://<user>:<pass>@<cluster>/qorvexa?retryWrites=true&w=majority
# NOTE: Prisma requires a replica set. Atlas M0+ and the compose Mongo are replica sets.
DATABASE_URL="mongodb://localhost:27017/qorvexa"

# Used to sign session cookies. Use a long random string (32+ chars).
# Generate:  openssl rand -hex 32
# The app REFUSES to boot with NODE_ENV=production unless this is set to a real value.
SESSION_SECRET="change-me-to-a-long-random-string"

# Express server port (the API + static client host). Docker maps 8787:8787.
PORT=8787

# Public origin of the app — used for OAuth redirects, tracking pixels and
# email click links. MUST be the real deployed origin in production,
# e.g. https://crm.example.com
PUBLIC_BASE_URL="http://localhost:8787"

# Comma-separated list of email domains allowed to self-register (empty = anyone).
ALLOWED_REGISTRATION_DOMAINS=""

# Optional: Google / GitHub SSO (Phase 0). Redirect URI:
#   <PUBLIC_BASE_URL>/api/auth/oauth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Optional: OAuth mock — completes the SSO flow as the seeded admin without a
# real provider. For local demos ONLY; disable in production.
# OAUTH_MOCK="1"

# Optional: communication mock — when true (default), the "email" provider is
# simulated and messages are stored as sent without leaving the box.
# EMAIL_MOCK="false"

# ── Phase 16 · real provider integrations (ADR-028) ─────────────────────────
# Every provider defaults to `mock` (zero credentials, demo/CI safe). A
# missing key is a graceful fallback, never a crash. See docs/54-spec-phase16.md.
#
# Email: mock | resend | sendgrid. EMAIL_MOCK=false still means resend.
EMAIL_PROVIDER="mock"
# Resend: https://resend.com/api-keys — from address must be a verified sender.
RESEND_API_KEY=""
RESEND_FROM_EMAIL=""
# SendGrid: https://app.sendgrid.com/settings/api_keys (v3 mail send).
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""
# Optional shared secret for provider event webhooks (SendGrid signature /
# Resend svix). When set, POST /api/integrations/email/webhook REQUIRES a
# valid signature; when empty (dev), the payload must reference a real message
# by its unguessable tracking token (capability proof).
EMAIL_WEBHOOK_SECRET=""
#
# AI: mock | openai (auto-selects openai when OPENAI_API_KEY is set). The
# model router seeds openai-gpt-4o-mini / openai-gpt-4o routes lazily.
AI_PROVIDER="mock"
OPENAI_API_KEY=""
# Optional: OpenAI-compatible base URL (Azure / enterprise gateway).
OPENAI_BASE_URL="https://api.openai.com"
OPENAI_MODEL="gpt-4o-mini"
#
# Telephony: Twilio (https://console.twilio.com). POST /api/calls/:id/place
# initiates a real call; status callbacks are verified with the auth token.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Scheduled snapshot backups (ADR-009). Archives land in backups/ (a Docker
# volume in the prod stack). SNAPSHOTS_ENABLED=false disables the job.
SNAPSHOT_INTERVAL_HOURS="24"
SNAPSHOTS_ENABLED="true"
