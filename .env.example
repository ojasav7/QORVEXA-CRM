# ── QORVEXA CRM · environment ──────────────────────────────────────────────

# MongoDB connection string.
# Local (docker):  mongodb://localhost:27017/qorvexa
# MongoDB Atlas:   mongodb+srv://<user>:<pass>@<cluster>/qorvexa?retryWrites=true&w=majority
DATABASE_URL="mongodb://localhost:27017/qorvexa"

# Used to sign session cookies. Use a long random string (32+ chars).
SESSION_SECRET="change-me-to-a-long-random-string"

# Express server port (the API + static client host).
PORT=8787

# Comma-separated list of email domains allowed to self-register (empty = anyone).
ALLOWED_REGISTRATION_DOMAINS=""

# Optional: Cloudinary (Phase 2+ media attachments). Not used yet.
# CLOUDINARY_URL="cloudinary://..."
