{
  "name": "qorvexa-crm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "QORVEXA — the intelligent operating system for business. Phase 0 (platform backbone) + Phase 1 (core CRM).",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "node scripts/build.mjs",
    "start": "tsx server/index.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "backfill:env": "tsx server/scripts/backfill-environment.ts",
    "backfill:pipeline": "tsx server/scripts/backfill-pipeline.ts",
    "seed": "tsx server/seed.ts",
    "mongo:up": "docker compose up -d mongo",
    "mongo:down": "docker compose down",
    "postinstall": "cd qorvexacrm && npm install --ignore-scripts",
    "setup": "npm install && npm run db:generate && npm run db:push && npm run seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/client": "6",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.1.0",
    "lucide-react": "^1.29.0",
    "mongodb": "^7.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.6.0",
    "tsx": "^4.20.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.2",
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/coverage-v8": "^4.1.11",
    "agentation": "^3.0.2",
    "concurrently": "^9.1.2",
    "prisma": "6",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.14",
    "vitest": "^4.1.11"
  }
}
