// QORVEXA CRM — Prisma schema (MongoDB provider)
// ---------------------------------------------------------------
// Phase 0 (platform backbone) + Phase 1 (core CRM).
//
// IMPORTANT MongoDB/Prisma constraints (documented in docs/01-architecture.md):
//  • No relations — every reference is an explicit `*Id` ObjectId string
//    joined in the service layer (by design: the blueprint's generic
//    Object + Relationship model maps onto this directly).
//  • No enums — use string columns validated at the service layer.
//  • `@updatedAt` is not available on MongoDB; updatedAt is maintained
//    by the service layer (see server/lib/object-service.ts).
//
// Every document carries `orgId` — multi-tenant isolation is enforced
// in the service layer for every query (see docs/04-permissions.md).
//
// ADR-008 (docs/08-decision-log.md): every data model also carries an
// `environment` scoping field (`production` | custom sandbox names). It is
// threaded through the central access layer (server/lib/access.ts) exactly
// like orgId — the request header `X-Environment` selects it, and the
// client persists the choice in localStorage. Sandbox rows are invisible
// to production queries (verified by the cross-env leak smoke test).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ── Phase 0 · Platform ───────────────────────────────────────────────────────

model Organization {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  slug      String   @unique
  plan      String   @default("free") // free | pro | enterprise
  settings  Json     @default("{}")   // locale, timezone, feature flags, data residency tags
  createdAt DateTime @default(now())
}

model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId         String   @db.ObjectId
  email         String   @unique // globally unique in Phase 0-1 (login is email-based)
  name          String
  passwordHash  String
  role          String   @default("rep") // admin | manager | rep (docs/04-permissions.md)
  title         String?
  active        Boolean  @default(true)
  lastLoginAt   DateTime?
  oauthProvider String? // google | github — set when the account signed in via SSO
  oauthId       String? // the provider's stable user id (for linking)
  // Phase 14 — MFA (TOTP). mfaSecret is base32; only a valid code enables it.
  mfaSecret        String?  // TOTP secret (base32) — never returned after setup
  mfaEnabled       Boolean  @default(false)
  mfaVerifiedAt    DateTime?
  mfaRecoveryHashes Json?   // sha256 list of one-time recovery codes (Phase 14)
  scimExternalId   String?  // SCIM 2.0 externalId (Phase 14 provisioning)
  createdAt        DateTime @default(now())

  @@index([orgId])
  @@index([orgId, email])
}

// Signed session cookie payload — the cookie itself is HMAC-signed with
// SESSION_SECRET; no server-side session table needed for Phases 0–1
// (upgraded to DB-backed sessions + device management in Phase 14).
// The `id` here is a session id used for audit correlation.

// Event bus persistence — every domain event that fires is written here
// (deal.stage_changed, contact.created, ...). Consumers: activity feed,
// webhook dispatch, future analytics/AI layers. See docs/03-event-catalog.md
model Event {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production") // ADR-008 — sandbox events never fire prod webhooks
  type        String // object.action, e.g. deal.stage_changed
  entity      String // object type, e.g. deal
  entityId    String   @db.ObjectId
  actorId     String   @db.ObjectId // user that caused it
  payload     Json     @default("{}") // { from, to, ... } or context
  createdAt   DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([orgId, environment, createdAt])
  @@index([orgId, entity, entityId])
  @@index([type])
}

// Audit trail — one row per field-level mutation on any object.
// Enables "what changed, when, by whom" and the Phase-15 Time Machine.
model AuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production") // ADR-008
  actorId     String   @db.ObjectId
  entity      String
  entityId    String   @db.ObjectId
  action      String // create | update | delete | stage_changed | ...
  before      Json? // prior field values (null on create)
  after       Json? // new field values (null on delete)
  changed     Json? // { field: { from, to } } — computed diff (null on create/delete)
  ip          String?
  createdAt   DateTime @default(now())

  @@index([orgId, entity, entityId])
  @@index([orgId, createdAt])
  @@index([orgId, environment, createdAt])
}

// Registered outbound webhooks. When an Event of a subscribed type fires,
// a delivery is POSTed to url with an HMAC signature header. docs/05-api-reference.md
model Webhook {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production") // ADR-008 — sandbox hooks only receive sandbox events
  url         String
  secret      String
  events      Json     @default("[]") // array of event type subscriptions, e.g. ["deal.stage_changed"]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([orgId])
  @@index([orgId, environment])
}

model WebhookDelivery {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId      String   @db.ObjectId
  environment String   @default("production") // ADR-008
  webhookId  String   @db.ObjectId
  eventId    String   @db.ObjectId
  status     String   @default("pending") // pending | success | failed
  statusCode Int?
  attempts   Int      @default(0)
  lastError  String?
  createdAt  DateTime @default(now())

  @@index([orgId, status])
}

// Custom-field registry — the "no-code object builder" (v1).
// Each row defines one custom field on an object type for an org.
// Actual values live in each object's `custom` Json column.
model FieldDef {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production") // ADR-008 — custom fields are per-environment too
  objectType  String // contact | account | lead | opportunity | task | ...
  key         String // machine key, e.g. "employeeCount"
  label       String // human label, e.g. "Employee count"
  type        String // text | number | date | boolean | select | multiselect | url | email
  required    Boolean  @default(false)
  options     Json     @default("[]") // for select/multiselect
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([orgId, objectType])
  @@index([orgId, environment, objectType])
}

// Feature-flag registry — one row per org × environment × known flag.
// The server owns the known-key list (server/lib/features.ts); these rows
// hold the org's override for a flag in a given environment. Effective state
// = Organization.settings.featureFlags[key] override → FeatureFlag row → default.
// The API (requireFeature middleware) is the real gate; the UI is advisory.
model FeatureFlag {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId          String   @db.ObjectId
  environment    String   @default("production")
  key            String // known flag key, e.g. "import.merge"
  label          String
  description    String?
  enabled        Boolean  @default(true)
  plans          Json     @default("[]") // plan tiers this flag applies to
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())

  @@unique([orgId, environment, key])
  @@index([orgId])
}

// Backup snapshots + restores (ADR-009) — every create/restore writes a row
// so the full backup history is audit-friendly. Restore always lands in a
// fresh sandbox environment, never production.
model BackupJob {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId         String   @db.ObjectId
  status        String   @default("running") // running | success | failed
  archivePath   String   // relative path under backups/
  sizeBytes     Int      @default(0)
  environment   String   @default("production") // environment the snapshot captured
  restoredToEnv String? // set when a restore created a fresh sandbox
  note          String?
  error         String?
  createdAt     DateTime @default(now())

  @@index([orgId, createdAt])
}

// Field-level permissions (blueprint principle #3) — one row per org × env ×
// object type × field key. Empty arrays mean "all roles". Admin always passes.
// readRoles gates what a role can see in list/detail responses; writeRoles gates
// what a role can set on create/update. Rows are managed in Settings → Custom fields.
model FieldPermission {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production")
  objectType  String // contact | account | ...
  fieldKey    String // core or custom field key
  readRoles   Json     @default("[]") // roles allowed to read; [] = everyone
  writeRoles  Json     @default("[]") // roles allowed to write; [] = everyone
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@unique([orgId, environment, objectType, fieldKey])
  @@index([orgId, objectType])
}

// API tokens (Phase 0 OAuth for integrations) — bearer tokens issued by admins
// for third-party apps/scripts. Only the sha256 hash is stored; the raw token is
// shown once at creation. Authenticated via `Authorization: Bearer <token>`.
model ApiToken {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  orgId      String    @db.ObjectId
  name       String
  tokenHash  String    @unique
  prefix     String // first 8 chars of the raw token (display only)
  role       String    @default("admin") // admin | manager | rep — the token acts as this role
  scopes     Json      @default("[\"all\"]") // e.g. ["all"] | ["read"] | ["read","write"]
  active     Boolean   @default(true)
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([orgId])
}

// ── Phase 1 · Platform entities ────────────────────────────────────────────────
// Segments (dynamic lists, Phase 1) and public lead-capture forms (Phase 1) are
// platform entities like FieldDef/FeatureFlag — org-scoped metadata the generic
// object service does not manage (membership + capture have their own semantics).

model Segment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production") // ADR-008
  name        String
  description String?
  objectType  String // contact | account | lead | opportunity | task
  criteria    Json     @default("{}") // { filters: [{ field, op, value }] } — dynamic membership
  active      Boolean  @default(true)
  createdBy   String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([orgId, environment])
}

// Public lead-capture forms (Phase 1) — an org publishes a form slug; the public
// page (no auth) POSTs to /api/public/forms/:slug/submit which creates a routed
// lead. `fields` = the subset of lead core fields the form exposes.
model LeadForm {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  name        String
  slug        String // url-safe, unique per org
  fields      Json     @default("[]") // [{ key, label, required, type }]
  submitLabel String   @default("Send")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@unique([orgId, slug])
  @@index([orgId])
}

// ── Phase 1 · Core CRM objects ────────────────────────────────────────────────
// All objects share the blueprint's standard shape (docs/02-data-model.md):
// core typed fields + `custom` Json for registry-defined fields + `tags`.
// `visibility`: owner | org — record-level access (docs/04-permissions.md).

model Contact {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production") // ADR-008
  ownerId     String   @db.ObjectId
  accountId   String?  @db.ObjectId
  promotedFrom String? // id of the source record when copied by env promotion
  firstName   String
  lastName    String
  email       String?
  phone       String?
  title       String?
  source      String?
  status      String   @default("new") // new | contacted | qualified | customer | lost
  tags        Json     @default("[]")
  custom      Json     @default("{}") // values for custom FieldDefs
  visibility  String   @default("org") // owner | org
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([orgId])
  @@index([orgId, environment])
  @@index([orgId, email])
  @@index([orgId, ownerId])
}

model Account {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production") // ADR-008
  ownerId     String   @db.ObjectId
  parentId    String?  @db.ObjectId // account hierarchy (parent/child)
  promotedFrom String? // id of the source record when copied by env promotion
  name        String
  industry    String?
  website     String?
  phone       String?
  employees   Int?
  tier        String? // SMB | Mid-Market | Enterprise
  tags        Json     @default("[]")
  custom      Json     @default("{}")
  visibility  String   @default("org")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([orgId])
  @@index([orgId, environment])
  @@index([orgId, name])
}

model Lead {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production") // ADR-008
  ownerId     String   @db.ObjectId
  promotedFrom String? // id of the source record when copied by env promotion
  firstName   String
  lastName    String
  email       String?
  phone       String?
  company     String?
  source      String?
  status      String   @default("new") // new | contacted | qualified | converted | lost
  score       Int      @default(0) // 0–100
  campaignId  String?  @db.ObjectId // Phase 5 attribution — landing page / form source campaign
  tags        Json     @default("[]")
  custom      Json     @default("{}")
  visibility  String   @default("org")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([orgId])
  @@index([orgId, environment])
  @@index([orgId, email])
  @@index([orgId, campaignId])
}

// ── Phase 2 · Communication Core ───────────────────────────────────────────────
// Email templates (Phase 2): reusable subject/body pairs with {{variable}}
// merge fields (e.g. {{contact.firstName}}). Admin/manager managed.
model EmailTemplate {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production") // ADR-008
  name        String
  category    String   @default("general") // general | sales | follow-up | marketing | internal
  subject     String
  body        String // plain-text + {{variable}} placeholders
  active      Boolean  @default(true)
  createdBy   String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([orgId, environment])
}

// Email messages (Phase 2) — the org's mailbox: sent (out) + received (in).
// Tracking: each outbound message gets a random trackingToken; the open pixel
// and click-redirect endpoints (public, token-scoped) update status and emit
// email.opened / email.clicked. `threadId` groups replies; a reply is a new
// Message with direction "in" sharing the thread.
model Message {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId         String   @db.ObjectId
  environment   String   @default("production") // ADR-008
  direction     String   @default("out") // in | out
  threadId      String // groups a conversation (set to own id on first send)
  trackingToken String? // for outbound tracking (open pixel + click redirect)
  fromEmail     String
  toEmail       String
  subject       String
  body          String
  status        String   @default("sent") // sent | opened | clicked | replied (best state reached)
  openedAt      DateTime?
  clickedAt     DateTime?
  repliedAt     DateTime?
  openedCount   Int      @default(0)
  // Phase 5 · Marketing — deliverability state (mock provider events, ADR-014)
  bouncedAt     DateTime? // hard bounce (mock) — email.bounced
  unsubscribedAt DateTime? // recipient opted out (mock) — email.unsubscribed
  campaignId    String?  @db.ObjectId // the Campaign that sent this (if any) — attribution + stats
  templateId    String?  @db.ObjectId // the EmailTemplate used (if any)
  contactId     String?  @db.ObjectId // auto-log reference
  accountId     String?  @db.ObjectId
  opportunityId String?  @db.ObjectId
  ownerId       String   @db.ObjectId
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  @@index([orgId, environment])
  @@index([orgId, environment, direction])
  @@index([orgId, environment, contactId])
  @@index([orgId, environment, threadId])
  @@index([orgId, environment, campaignId])
}

// Call log entries (Phase 2) — click-to-call + manual logging. When org
// settings enable recording, a mock recordingUrl + basic transcription are
// generated (real telephony provider integration is deferred; see ADR-014).
model Call {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId         String   @db.ObjectId
  environment   String   @default("production") // ADR-008
  direction     String   @default("out") // in | out
  phone         String
  durationSec   Int      @default(0)
  status        String   @default("completed") // completed | no-answer | voicemail
  recordingUrl  String?
  transcript    String?
  notes         String?
  contactId     String?  @db.ObjectId // auto-log reference
  accountId     String?  @db.ObjectId
  opportunityId String?  @db.ObjectId
  ownerId       String   @db.ObjectId
  startedAt     DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  @@index([orgId, environment])
  @@index([orgId, environment, contactId])
  @@index([orgId, environment, ownerId])
}

// Meetings (Phase 2) — scheduled + completed meetings. Booking-page bookings
// create meetings owned by the assigned (round-robin) host.
model Meeting {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId         String   @db.ObjectId
  environment   String   @default("production") // ADR-008
  title         String
  startsAt      DateTime
  endsAt        DateTime
  status        String   @default("scheduled") // scheduled | completed | cancelled | no-show
  location      String? // virtual | physical address | phone
  notes         String?
  attendeeName  String? // booking page attendee (public bookings)
  attendeeEmail String?
  contactId     String?  @db.ObjectId
  accountId     String?  @db.ObjectId
  opportunityId String?  @db.ObjectId
  ownerId       String   @db.ObjectId // host
  bookingPageId String?  @db.ObjectId
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  @@index([orgId, environment])
  @@index([orgId, environment, startsAt])
  @@index([orgId, environment, ownerId])
}

// Public booking pages (Phase 2) — a shareable URL that lets prospects book a
// meeting with the org. `hostPool` is a round-robin pool of user ids (mirrors
// the lead-routing pattern); each booking advances a persisted cursor. Slots
// are generated from durationMins + bufferMins over availableDays × start/end
// hours (org timezone). Slug is the public URL handle, unique per org.
model BookingPage {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId        String   @db.ObjectId
  name         String
  slug         String // url-safe, unique per org
  description  String?
  durationMins Int      @default(30)
  bufferMins   Int      @default(5)
  hostPool     Json     @default("[]") // user ids, round-robin assignment
  cursor       Int      @default(0) // persisted round-robin position
  availableDays Json    @default("[1,2,3,4,5]") // 0=Sun … 6=Sat
  startHour    Int      @default(9) // 0-23, org local time
  endHour      Int      @default(17)
  timezone     String   @default("UTC")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  @@unique([orgId, slug])
  @@index([orgId])
}

// ── Phase 2-lite · Multi-pipeline ─────────────────────────────────────────────
// A pipeline is per-org (× environment) deal-board config with its own stages
// (key, label, probability, order). The org's DEFAULT pipeline is lazily seeded
// from the static registry PIPELINE on first access, so existing orgs and new
// orgs both get a working sales pipeline without a migration. Deals reference a
// pipeline via Opportunity.pipelineId; NULL means "the org's default pipeline".
model Pipeline {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production") // ADR-008
  name        String
  isDefault   Boolean  @default(false)
  stages      Json     @default("[]") // [{ key, label, probability, order }]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([orgId, environment])
  @@index([orgId, environment, isDefault])
}

// Deal / opportunity pipeline. Stage moves emit deal.stage_changed events
// and are audit-logged (event-sourced for the Phase-15 Time Machine).
// pipelineId: which Pipeline this deal is on (null = org default).
model Opportunity {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String    @db.ObjectId
  environment String    @default("production") // ADR-008
  ownerId     String    @db.ObjectId
  accountId   String?   @db.ObjectId
  contactId   String?   @db.ObjectId
  pipelineId  String?   @db.ObjectId // Phase 2-lite multi-pipeline
  promotedFrom String?  // id of the source record when copied by env promotion
  name        String
  stage       String    @default("qualified") // a stage key of the deal's pipeline
  amount      Float     @default(0)
  probability Int       @default(10) // %, derived from the pipeline's stage
  closeDate   DateTime?
  winReason   String?
  lostReason  String?
  competitors String?
  tags        Json      @default("[]")
  custom      Json      @default("{}")
  visibility  String    @default("org")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now())

  @@index([orgId])
  @@index([orgId, environment])
  @@index([orgId, stage])
  @@index([orgId, pipelineId])
  @@index([orgId, ownerId])
}

model Task {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId         String   @db.ObjectId
  environment   String   @default("production") // ADR-008
  ownerId       String   @db.ObjectId
  contactId     String?  @db.ObjectId
  opportunityId String? @db.ObjectId
  promotedFrom  String? // id of the source record when copied by env promotion
  title         String
  description   String?
  dueAt         DateTime?
  status        String   @default("todo") // todo | in_progress | done
  priority      String   @default("medium") // low | medium | high
  tags          Json     @default("[]")
  custom        Json     @default("{}")
  visibility    String   @default("org")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  @@index([orgId])
  @@index([orgId, environment])
  @@index([orgId, ownerId])
  @@index([orgId, status])
}

model Note {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production") // ADR-008
  authorId    String   @db.ObjectId
  contactId   String?  @db.ObjectId
  accountId   String?  @db.ObjectId
  opportunityId String? @db.ObjectId
  promotedFrom String? // id of the source record when copied by env promotion
  body        String
  tags        Json     @default("[]")
  custom      Json     @default("{}")
  visibility  String   @default("org")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([orgId])
  @@index([orgId, environment])
  @@index([orgId, contactId])
}

// ── Phase 3 · Automation & Workflow Engine ───────────────────────────────────
// A workflow is a declarative row: trigger (an event, optionally filtered) →
// conditions (field filters on the triggering record + event payload) → actions
// (create task / notify / update record). The engine (server/lib/automations.ts)
// subscribes to the event bus with onEvent("*") and evaluates each matching
// org × environment workflow in-process (ADR-015). runCount/lastRunAt are the
// cheap "is this workflow alive" stats shown in the UI.
model Automation {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production") // ADR-008 — sandbox workflows never fire on prod events
  name        String
  description String?
  trigger     Json     @default("{}") // { kind: "event", event: "deal.stage_changed", to?: "won" }
  conditions  Json     @default("[]") // [{ field, op, value }]
  actions     Json     @default("[]") // [{ type: "create_task" | "notify" | "update_record", ... }]
  active      Boolean  @default(true)
  runCount    Int      @default(0)
  lastRunAt   DateTime?
  createdBy   String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([orgId, environment])
  @@index([orgId, environment, active])
}

// One row per engine evaluation (matched or not) — the workflow's run log and
// the Phase-3 "conflict resolution" surface: every action's outcome is visible,
// so a failing or conflicting automation is diagnosable instead of mysterious.
// actions = [{ type, status: "ok" | "skipped" | "failed", detail?, entityId? }]
model AutomationRun {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId         String   @db.ObjectId
  environment   String   @default("production")
  automationId  String   @db.ObjectId
  eventType     String // e.g. deal.stage_changed
  entity        String // e.g. opportunity
  entityId      String   @db.ObjectId
  matched       Boolean  @default(true)
  actions       Json     @default("[]") // per-action outcomes
  note          String? // why it didn't match (condition/trigger filter), or errors
  triggeredBy   String   @default("event") // event | test
  createdAt     DateTime @default(now())

  @@index([orgId, automationId, createdAt])
  @@index([orgId, environment, createdAt])
}

// In-app notifications (Phase 3) — the automation `notify` action writes rows
// here, and the header bell reads them. Owned by userId (org-scoped like every
// row); list/read endpoints scope by userId so users never see each other's.
model Notification {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production")
  userId      String   @db.ObjectId
  title       String
  body        String?
  kind        String   @default("system") // automation | journey | metric | system
  link        String? // e.g. "/deals?id=..." — where the notification points
  read        Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([orgId, userId, read])
  @@index([orgId, userId, createdAt])
}

// ── Phase 6 · Analytics, Forecasting & Business Intelligence ───────────────
// A forecast is a DURABLE SNAPSHOT of the live weighted pipeline (ADR-018):
// the org's current pipeline totals (raw / weighted / commit / best case),
// the per-stage detail, and a per-owner breakdown — persisted by the admin
// `refresh` endpoint (which emits forecast.updated). Live reads recompute
// from current rows; this row is the history + the "as of" record.
model Forecast {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production")
  buckets     Json     @default("{}") // { pipeline, weighted, commit, bestCase }
  stages      Json     @default("[]") // [{ stage, probability, count, amount, weighted }]
  byOwner     Json     @default("[]") // [{ ownerId, ownerName, pipeline, weighted, commit, bestCase }]
  metricKeys  Json     @default("[]") // lineage: the metric keys that fed this snapshot
  createdBy   String   @db.ObjectId
  createdAt   DateTime @default(now())

  @@index([orgId, environment, createdAt])
}

// Saved dashboard configs (flag analytics.reports) — same row-as-config
// philosophy as segments/automations/journeys. kind + keys select which live
// metrics the report renders; reads are open, writes admin-only.
model Report {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production")
  name        String
  description String?
  kind        String   @default("sales") // sales | marketing | service | revenue
  keys        Json     @default("[]") // metric keys to render (empty = all for the kind)
  active      Boolean  @default(true)
  createdBy   String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([orgId, environment])
}

// ── Phase 4 · Customer Service / Helpdesk ───────────────────────────────────
// Tickets are a first-class object type (ADR-016): the generic object service
// powers CRUD/audit/events/search/custom fields, and a thin ticket router
// (server/routes/tickets.ts) adds service-specific behavior — reference
// numbers, SLA deadlines, status transitions, replies, escalation, legal hold,
// email intake, convert-to-lead. SLA status is COMPUTED at read from slaDueAt
// (server/lib/slas.ts); the sweep just persists breachedAt + emits events.
model Ticket {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId           String   @db.ObjectId
  environment     String   @default("production") // ADR-008
  reference       String // per-org human ref, e.g. TKT-0001 (unique per org × env)
  subject         String
  description     String?
  status          String   @default("new") // new | open | pending | resolved | closed
  priority        String   @default("low") // low | medium | high | urgent
  channel         String   @default("web") // email | web | chat | whatsapp | sms | phone | social
  source          String   @default("manual") // portal | email | manual
  ownerId         String   @db.ObjectId // the assignee (generic owner field)
  contactId       String?  @db.ObjectId
  accountId       String?  @db.ObjectId
  slaDueAt        DateTime?
  breachedAt      DateTime?
  escalated       Boolean  @default(false)
  escalatedAt     DateTime?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  legalHold       Boolean  @default(false)
  tags            Json     @default("[]")
  custom          Json     @default("{}")
  visibility      String   @default("org")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  @@unique([orgId, environment, reference])
  @@index([orgId, environment])
  @@index([orgId, environment, status])
  @@index([orgId, environment, priority])
  @@index([orgId, environment, ownerId])
}

// The ticket reply thread (ADR-016). `internal` marks staff-only replies —
// public replies are what the portal lookup shows the customer.
model TicketReply {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production") // ADR-008
  ticketId    String   @db.ObjectId
  authorId    String   @db.ObjectId
  body        String
  internal    Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([orgId, ticketId, createdAt])
}

// Knowledge base articles (Phase 4) — published articles appear in the public
// portal and drive self-service deflection. viewCount increments on read of a
// published article (cheap popularity signal). Version history is deferred.
model KnowledgeArticle {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production") // ADR-008
  title       String
  slug        String
  body        String
  category    String   @default("general") // general | billing | technical | account | other
  tags        Json     @default("[]")
  published   Boolean  @default(false)
  authorId    String   @db.ObjectId
  viewCount   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@unique([orgId, environment, slug])
  @@index([orgId, environment, published])
  @@index([orgId, environment, category])
}

// SLA policy (ADR-016) — declarative per-priority response-hour targets. The
// org's default policy is lazily seeded (like pipelines); targets are JSON so
// they're data-editable later without a schema change.
// targets = { low: { responseHours }, medium: { responseHours }, high: …, urgent: … }
model SlaPolicy {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production") // ADR-008
  name        String
  targets     Json     @default("{}")
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([orgId, environment, active])
}

// Public self-service portal pages (Phase 4) — a shareable URL where customers
// submit tickets and look them up by reference (honeypot + rate limit, same
// guards as public leads/booking). Slug is the public URL handle, unique per
// org × environment. Same shape philosophy as LeadForm / BookingPage.
model PortalPage {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId             String   @db.ObjectId
  environment       String   @default("production") // ADR-008
  name              String
  slug              String // url-safe, unique per org
  description       String?
  autoCreateContact Boolean  @default(true)
  active            Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  @@unique([orgId, environment, slug])
  @@index([orgId])
}

// ── Phase 5 · Marketing Automation & Journey Orchestration ──────────────────
// Campaigns are config entities (ADR-017): an email campaign targeted at a
// dynamic Segment audience, with optional A/B subject variants. Sending writes
// per-recipient Message + CampaignRecipient rows through the Phase-2 email
// path (tracking + events for free). Counts are rollups kept on the row for
// cheap list display; open/click rates and ROI are computed at read.
model Campaign {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId             String   @db.ObjectId
  environment       String   @default("production") // ADR-008
  name              String
  description       String?
  status            String   @default("draft") // draft | active | paused | sent
  channel           String   @default("email") // email v1 (ADR-014 mock provider)
  subject           String
  body              String
  templateId        String?  @db.ObjectId // EmailTemplate used for the send (if any)
  audienceSegmentId String?  @db.ObjectId // the Segment to send to (Phase 1 dynamic lists)
  ab                Json     @default("{}") // { enabled, splitA, subjectB } — A/B subject variants
  winner            String? // A | B | null — declared by open rate (or forced)
  sendAt            DateTime? // scheduled send (v1: manual send; field reserved)
  sentCount         Int      @default(0)
  openedCount       Int      @default(0)
  clickedCount      Int      @default(0)
  createdBy         String   @db.ObjectId
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  @@index([orgId, environment])
  @@index([orgId, environment, status])
}

// One row per sent campaign message — the per-recipient attribution + A/B
// comparison surface. variant = which subject the recipient got; status rolls
// up from the Message's open/click tracking.
model CampaignRecipient {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production") // ADR-008
  campaignId  String   @db.ObjectId
  contactId   String   @db.ObjectId
  messageId   String?  @db.ObjectId
  variant     String   @default("A") // A | B
  status      String   @default("sent") // sent | opened | clicked
  openedAt    DateTime?
  clickedAt   DateTime?
  createdAt   DateTime @default(now())

  @@index([orgId, environment, campaignId])
  @@index([orgId, environment, campaignId, variant])
  @@index([orgId, contactId])
}

// Public landing pages (Phase 5) — a shareable URL with a headline/subtext +
// themed form that captures routed leads. Slug is the public handle, unique per
// org × env. Same shape philosophy as LeadForm / PortalPage; submissions tag
// the lead's `custom` field with the linked campaign for attribution.
model LandingPage {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId           String   @db.ObjectId
  environment     String   @default("production") // ADR-008
  name            String
  slug            String
  headline        String
  subtext         String?
  ctaLabel        String   @default("Submit")
  successMessage  String   @default("Thanks — we'll be in touch soon.")
  theme           String   @default("indigo") // indigo | emerald | rose | amber | slate
  campaignId      String?  @db.ObjectId // attribution — the campaign this page drives
  fields          Json     @default("[]") // [{ key: "firstName"|..., enabled: true }]
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  @@unique([orgId, environment, slug])
  @@index([orgId])
}

// A customer journey (Phase 5, ADR-017): trigger (event or segment entry) →
// ordered steps (wait / send_email / notify / create_task / update_record /
// condition / end). The engine (server/lib/journeys.ts) subscribes to the
// event bus like workflows and enrolls the triggering record; a ticker
// advances waiting enrollments. Steps are data, not code (same philosophy as
// Segment.criteria / Automation.actions).
model Journey {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId        String   @db.ObjectId
  environment  String   @default("production") // ADR-008
  name         String
  description  String?
  trigger      Json     @default("{}") // { kind: "event", event } | { kind: "segment", segmentId }
  steps        Json     @default("[]") // [{ type: "wait"|..., ... }]
  active       Boolean  @default(true)
  enrolledCount Int     @default(0)
  createdBy    String   @db.ObjectId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  @@index([orgId, environment])
  @@index([orgId, environment, active])
}

// One active row per (journey, entity) — the loop guard + ticker queue.
model JourneyEnrollment {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production")
  journeyId   String   @db.ObjectId
  entity      String // contact | lead
  entityId    String   @db.ObjectId
  currentStep Int      @default(0)
  status      String   @default("active") // active | waiting | completed | exited
  enteredAt   DateTime @default(now())
  nextRunAt   DateTime? // set by wait steps; the ticker advances when due
  completedAt DateTime?
  createdAt   DateTime @default(now())

  @@unique([orgId, environment, journeyId, entityId])
  @@index([orgId, environment, journeyId, status])
  @@index([orgId, environment, status, nextRunAt])
}

// ── Phase 7 · CDP / Customer 360 ───────────────────────────────────────────
// The UNIFIED customer identity (ADR-019). One row per person per org × env:
// members are the raw contact/lead records that identity resolution decided
// are the same person (email is the deterministic key, phone + name+company
// are secondary rules — documented in docs/25-cdp-guide.md). The profile is
// the anchor for behavioral events, the health engine, and the 360 view.
// mergedFromIds keeps lineage when an admin merges two profiles
// (customer.identity_merged).
model IdentityProfile {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId            String   @db.ObjectId
  environment      String   @default("production") // ADR-008
  email            String // canonical (lowercased) — unique per org × env
  firstName        String?
  lastName         String?
  phone            String?
  company          String?
  title            String?
  accountId        String?  @db.ObjectId // primary account (from the highest-value member)
  primaryContactId String?  @db.ObjectId // preferred contact member
  primaryLeadId    String?  @db.ObjectId // preferred lead member
  memberIds        Json     @default("[]") // ["contact:<id>", "lead:<id>", ...] — unified records
  mergedFromIds    Json     @default("[]") // profile ids merged INTO this one (identity lineage)
  tags             Json     @default("[]")
  custom           Json     @default("{}")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())

  @@unique([orgId, environment, email])
  @@index([orgId, environment])
}

// Behavioral event tracking (web / product / purchase / support / ads) —
// DISTINCT from the system Event log: it records what the CUSTOMER did across
// every touchpoint, keyed to an identity profile. Two ingestion paths: the
// authenticated API (POST /api/cdp/behaviors — websites/products call this)
// and the event-bus mirror (startCdpEngine mirrors selected system events —
// email.opened, form.submitted, ticket.created, … — into behaviors).
model BehaviorEvent {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId      String   @db.ObjectId
  environment String  @default("production") // ADR-008
  type       String // page_view | product_use | purchase | ad_click | email_opened | …
  profileId  String?  @db.ObjectId // the identity this touchpoint belongs to
  contactId  String?  @db.ObjectId // direct record reference (when known)
  leadId     String?  @db.ObjectId
  entity     String? // what was touched: message | landing | ticket | meeting | call | …
  entityId   String?  @db.ObjectId
  value      Float? // numeric payload (e.g. purchase amount)
  meta       Json     @default("{}") // free-form context (page, campaign, referrer, …)
  source     String   @default("api") // api | event-bus | seed
  ip         String?
  occurredAt DateTime @default(now()) // when the customer actually did it
  createdAt  DateTime @default(now())

  @@index([orgId, environment, profileId, occurredAt])
  @@index([orgId, environment, type, occurredAt])
  @@index([orgId, environment, contactId])
}

// Persisted health snapshots (the customer health engine, ADR-019) — health is
// COMPUTED on read (server/lib/health.ts); an admin refresh persists one row
// per profile so the UI has history + deltas + the customer.health_changed /
// customer.churn_risk_changed event emissions.
model HealthScore {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId        String   @db.ObjectId
  environment  String   @default("production") // ADR-008
  profileId    String   @db.ObjectId
  score        Int      @default(0) // 0–100 composite (explained in components)
  churnRisk    Int      @default(0) // 0–100 (100 − health, adjusted)
  components   Json     @default("[]") // [{ key, label, weight, value, inputs }] — the explanation
  previousScore Int?   // delta vs the previous snapshot (health_changed trend)
  refreshId    String?  // groups one refresh pass (all profiles share it)
  createdAt    DateTime @default(now())

  @@index([orgId, environment, profileId, createdAt])
  @@index([orgId, environment, refreshId])
}

// Right-to-portability full-tenant export (🆕 blueprint) — one row per bundle.
// The bundle is a single JSON file with EVERY org × environment collection
// (data + audit + events), downloadable by the admin (GDPR portability).
model PortabilityExport {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production") // ADR-008
  status      String   @default("running") // running | success | failed
  path        String? // relative path under backups/portability/
  sizeBytes   Int      @default(0)
  note        String?
  error       String?
  requestedBy String   @db.ObjectId
  createdAt   DateTime @default(now())
  completedAt DateTime?

  @@index([orgId, environment, createdAt])
}

// The journey run log (conflict-resolution surface, like AutomationRun) — one
// row per executed step with its outcome.
model JourneyStepRun {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId        String   @db.ObjectId
  environment  String   @default("production")
  journeyId    String   @db.ObjectId
  enrollmentId String   @db.ObjectId
  stepIndex    Int
  stepType     String // wait | send_email | notify | create_task | update_record | condition | end
  status       String   @default("ok") // ok | skipped | failed
  detail       String?
  createdAt    DateTime @default(now())

  @@index([orgId, journeyId, createdAt])
  @@index([orgId, enrollmentId])
}

// ── Phase 8 · AI Assistant Layer (non-agentic copilot) ────────────────────
// The MODEL CATALOG + routing config (🆕 model router): one row per model the
// org can route to. Rows are data (like SlaPolicy targets / automation
// triggers) so costs, latency, capabilities, and region residency are editable
// without a schema change. The router (server/lib/ai.ts) picks a row per
// feature call based on the org's policy (settings.ai: { defaultModel,
// preference: cost|quality|latency, preferredRegion }) + the row's
// capabilities/region/weight — every decision is explainable and recorded on
// the AIInsight row that the call produced.
model ModelRoute {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId         String   @db.ObjectId
  environment   String   @default("production") // ADR-008
  name          String // model id, e.g. "mock-fast" | "eu-mock-premium"
  provider      String   @default("mock") // mock v1 (ADR-014 discipline — no external calls)
  tier          String   @default("standard") // standard | premium
  capabilities  Json     @default("[]") // ["summary","score","search","draft","sentiment","intent"]
  costPer1kIn   Float    @default(0) // simulated $ per 1k input tokens
  costPer1kOut  Float    @default(0) // simulated $ per 1k output tokens
  latencyMs     Int      @default(0) // simulated avg latency (router + insight record)
  region        String   @default("any") // any | eu | us — data-residency routing (🆕 blueprint)
  active        Boolean  @default(true)
  routingWeight Int      @default(1) // preference tie-break within a policy
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  @@index([orgId, environment, active])
}

// The durable AI OUTPUT record — every AI-assisted generation that a user (or
// the engine) triggers writes one row: the human-readable content, the
// structured payload (breakdown / evidence / inputs), the model that produced
// it, latency, confidence, and what the data firewall redacted. This is the
// explainability + audit surface ("show evidence", 🆕 confidence scoring).
// Events: ai.summary_generated (kind summary/draft), ai.score_computed (kind
// score), ai.confidence_flagged (lowConfidence).
model AiInsight {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId         String   @db.ObjectId
  environment   String   @default("production") // ADR-008
  kind          String // summary | score | sentiment | intent | draft | search
  feature       String // e.g. "deal.summary" | "lead.score" | "call.summary"
  entity        String? // contact | account | lead | opportunity | ticket | call | meeting | …
  entityId      String?  @db.ObjectId
  title         String? // short label, e.g. "Northwind — Retail Platform Expansion"
  content       String? // human-readable output (summary text / drafted email / reason)
  confidence    Int      @default(0) // 0–100 (🆕 confidence scoring — surfaced in the UI)
  lowConfidence Boolean  @default(false) // confidence < threshold → ai.confidence_flagged
  modelId       String? // the routed model that produced it
  latencyMs     Int      @default(0)
  payload       Json     @default("{}") // structured output: breakdown, evidence, inputs
  redacted      Json     @default("[]") // [{ type, count }] — what the firewall stripped
  createdBy     String   @db.ObjectId
  createdAt     DateTime @default(now())

  @@index([orgId, environment, createdAt])
  @@index([orgId, environment, kind])
  @@index([orgId, environment, entity, entityId])
}

// Short-term AI memory (blueprint entity) — the copilot can stash per-user or
// per-record context (last query, preferred tone, session notes) with a TTL.
// The AI engine ticker (startAiEngine) purges expired rows like the journey
// ticker advances due waits.
model AiMemory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production") // ADR-008
  scopeType   String // user | entity
  scopeId     String   @db.ObjectId
  key         String
  value       Json     @default("{}")
  expiresAt   DateTime? // TTL — expired rows are purged by the engine ticker
  createdBy   String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([orgId, environment, scopeType, scopeId])
  @@index([orgId, environment, expiresAt])
}

// ── Phase 9 · AI Agent Platform (autonomous, governed) ─────────────────────
// An AGENT is a declarative row (like Automation/Journey — the ADR-015/017
// pattern) that AUTONOMOUSLY proposes work: it watches triggers, gathers a
// firewalled context, decides actions with a RISK TIER (🟢 automatic, 🟡
// approval required, 🔴 human required — blueprint §3.4), and executes only
// what its governance allows. The engine (server/lib/agents.ts) is an
// event-bus subscriber (like automations) + a manual-run + test endpoints.
// killSwitched is the per-agent kill switch (🆕 blueprint); the org-wide kill
// switch lives in Organization.settings.agents.killSwitched.
model Agent {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId          String   @db.ObjectId
  environment    String   @default("production") // ADR-008
  name           String
  kind           String   @default("custom") // lead | sales | service | renewal | custom (template)
  description    String?
  trigger        Json     @default("{}") // { kind: "event", event: "lead.created" } | { kind: "manual" }
  rules          Json     @default("[]") // [{ field, op, value }] — who/what this agent acts on
  tools          Json     @default("[]") // ["create_task","notify","update_record","send_email","create_ticket"]
  tierPolicy     Json     @default("{}") // per-tool risk overrides: { tool: "green"|"yellow"|"red" }
  memoryEnabled  Boolean  @default(true)
  active         Boolean  @default(true)
  killSwitched   Boolean  @default(false) // 🆕 per-agent kill switch
  runCount       Int      @default(0)
  successCount   Int      @default(0) // runs where every action succeeded
  approveCount   Int      @default(0) // runs that needed 🟡 approval
  costTotal      Float    @default(0) // 🆕 cost metering (simulated tokens × ModelRoute cost)
  createdBy      String   @db.ObjectId
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())

  @@index([orgId, environment])
  @@index([orgId, environment, active])
}

// One AGENT EXECUTION (the audit trail: input → data used → reasoning →
// proposed actions → approval → result). Each run proposes actions; a run is
// complete when its actions are resolved (executed / rejected / skipped). The
// run row IS the AI audit trail (blueprint: input → data used → reasoning →
// action → result → approval).
model AgentRun {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId         String   @db.ObjectId
  environment   String   @default("production")
  agentId       String   @db.ObjectId
  trigger       String   @default("manual") // event | manual | test
  eventType     String? // the event that fired this run (when triggered by the bus)
  entity        String // contact | lead | opportunity | ticket | …
  entityId      String   @db.ObjectId
  context       Json     @default("{}") // the firewalled input + data used (audit)
  reasoning     String? // the agent's explanation for its actions
  status        String   @default("proposed") // proposed | waiting_approval | executed | rejected | failed | skipped
  riskSummary   Json     @default("{}") // { green: n, yellow: n, red: n }
  cost          Float    @default(0) // simulated cost of this run
  createdBy     String   @db.ObjectId // the agent (creator = agent id) or user for manual
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  @@index([orgId, agentId, createdAt])
  @@index([orgId, environment, status])
  @@index([orgId, entity, entityId])
}

// One PROPOSED/EXECUTED ACTION within a run — the risk tier is recorded, and
// the approval path (🟡) / human step (🔴) lives here: proposed → approved /
// rejected → executed. AgentAction rows + AgentRun rows together are the full
// AI audit trail.
model AgentAction {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId         String   @db.ObjectId
  environment   String   @default("production")
  runId         String   @db.ObjectId
  agentId       String   @db.ObjectId
  tool          String // create_task | notify | update_record | send_email | create_ticket
  riskTier      String   @default("green") // green 🟢 | yellow 🟡 | red 🔴
  params        Json     @default("{}") // the tool call arguments
  reason        String? // why the agent proposed this
  status        String   @default("proposed") // proposed | approved | rejected | executed | failed
  result        Json     @default("{}") // outcome detail (entityId created, error, …)
  approvedBy    String?  @db.ObjectId // who approved the 🟡/🔴 action
  cost          Float    @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  @@index([orgId, runId])
  @@index([orgId, agentId, status])
}

// Agent MEMORY — the agent's durable per-entity scratchpad (blueprint entity).
// Distinct from AiMemory (the copilot's per-user notes): this is what the
// agent learned about a contact/lead/deal (e.g. "buyer wants security
// deep-dive", "deal in negotiation"), keyed by entity so it persists across
// runs and feeds future context.
model AgentMemory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production")
  agentId     String   @db.ObjectId
  entity      String // contact | lead | opportunity | …
  entityId    String   @db.ObjectId
  key         String
  value       Json     @default("{}")
  expiresAt   DateTime? // TTL — the agent engine ticker purges expired rows
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([orgId, environment, agentId, entity, entityId])
  @@index([orgId, environment, expiresAt])
}

// The TESTING / SIMULATION LAB (🆕 blueprint) — replay a historical scenario
// (an event + entity) against an agent WITHOUT executing anything. The result
// is the proposed-action list + risk summary + predicted cost; a pass means
// every action is executable under governance (no red-tier block, no tool
// beyond the allowlist). AgentTest rows keep the simulation history.
model AgentTest {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production")
  agentId     String   @db.ObjectId
  name        String // scenario name
  entity      String
  entityId    String   @db.ObjectId
  status      String   @default("passed") // passed | failed | blocked
  actions     Json     @default("[]") // the proposed actions (dry-run, not executed)
  riskSummary Json     @default("{}") // { green, yellow, red }
  predictedCost Float  @default(0)
  note        String? // why it failed / was blocked
  createdBy   String   @db.ObjectId
  createdAt   DateTime @default(now())

  @@index([orgId, agentId, createdAt])
}

// ── Phase 10 · Revenue Cloud (Products, CPQ, Contracts, Billing) ───────────
// The money half of the CRM (ADR-022). Like campaigns/journeys, the CPQ +
// billing entities are config/domain rows with their own lifecycle semantics
// (quote approval → signature → order → contract → subscription → invoice →
// payment), while totals + MRR/ARR are DERIVED at read (never stored as
// truth) — the Phase 6/ADR-018 discipline applied to revenue. The engine
// (server/lib/revenue.ts) advances subscription billing + dunning on a ticker,
// exactly like the journey engine.

// The product catalog. `components` makes a product a BUNDLE: [{ productId,
// quantity }] of component products (resolved for quote/order line prices).
// `sku` is unique per org × env.
model Product {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production") // ADR-008
  name        String
  sku         String // unique per org × env (bundle-safe line pricing)
  description String?
  category    String   @default("general") // software | service | hardware | bundle | other
  listPrice   Float    @default(0)
  cost        Float    @default(0)
  taxable     Boolean  @default(true)
  components  Json     @default("[]") // [{ productId, quantity }] — bundle definition
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@unique([orgId, environment, sku])
  @@index([orgId, environment])
}

// Price books: named price lists with per-product prices (JSON entries,
// SlaPolicy-style). The org's DEFAULT price book is lazily seeded; quotes
// resolve line prices from a book (falling back to the product listPrice).
// `entries` = [{ productId, price }]; `discounts` = [{ productId, pct }] (an
// org-wide discount list applied at quote build time).
model PriceBook {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production")
  name        String
  isDefault   Boolean  @default(false)
  entries     Json     @default("[]") // [{ productId, price }]
  discounts   Json     @default("[]") // [{ productId, pct }]
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([orgId, environment])
  @@index([orgId, environment, isDefault])
}

// Quote templates (blueprint CPQ item) — layout/language/header/footer for a
// professional quote document. Quotes reference one; the template is data
// (like SlaPolicy targets) so orgs tune the look without a deploy.
model QuoteTemplate {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production")
  name        String
  layout      String   @default("standard") // standard | professional | compact
  language    String   @default("en") // en | de | fr | es — quote doc language
  header      String? // e.g. "Thank you for choosing Qorvexa"
  footer      String? // e.g. "Prices valid for 30 days"
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([orgId, environment])
}

// A CPQ QUOTE. `lines` is the priced quote content: [{ productId, productName,
// sku, quantity, unitPrice, discountPct, lineTotal }]. Totals are computed at
// build time AND re-derived at read (lineTotal sums must reconcile). The
// lifecycle is the CPQ approval + e-signature flow: draft → needs_approval →
// approved → sent → signed → won | lost | voided. `signature` is the mock
// e-signature (ADR-014 discipline: no external e-sign provider in v1).
model Quote {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId         String   @db.ObjectId
  environment   String   @default("production")
  quoteNumber   String // per-org ref, e.g. Q-0001 (unique per org × env)
  name          String
  opportunityId String?  @db.ObjectId // the deal this quote serves
  accountId     String?  @db.ObjectId
  contactId     String?  @db.ObjectId
  priceBookId   String?  @db.ObjectId
  templateId    String?  @db.ObjectId // QuoteTemplate used (document style)
  status        String   @default("draft") // draft | needs_approval | approved | sent | signed | won | lost | voided
  lines         Json     @default("[]") // [{ productId, productName, sku, quantity, unitPrice, discountPct, lineTotal }]
  subtotal      Float    @default(0)
  discountTotal Float    @default(0)
  taxTotal      Float    @default(0)
  total         Float    @default(0)
  currency      String   @default("USD")
  validUntil    DateTime?
  signature     Json     @default("{}") // { name, at, email? } — mock e-signature
  approvals     Json     @default("[]") // [{ by, name?, role, at, decision }] — approval trail
  createdBy     String   @db.ObjectId
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  @@unique([orgId, environment, quoteNumber])
  @@index([orgId, environment])
  @@index([orgId, environment, status])
  @@index([orgId, environment, opportunityId])
}

// An ORDER — created from a signed/approved quote (or manually). Same line
// shape as the quote; totals re-derived at read. Lifecycle: draft → confirmed
// → fulfilled → cancelled.
model Order {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production")
  orderNumber String // per-org ref, e.g. ORD-0001
  quoteId     String?  @db.ObjectId
  accountId   String?  @db.ObjectId
  contactId   String?  @db.ObjectId
  status      String   @default("draft") // draft | confirmed | fulfilled | cancelled
  lines       Json     @default("[]") // same shape as Quote.lines
  subtotal    Float    @default(0)
  discountTotal Float  @default(0)
  taxTotal    Float    @default(0)
  total       Float    @default(0)
  currency    String   @default("USD")
  placedAt    DateTime?
  createdBy   String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@unique([orgId, environment, orderNumber])
  @@index([orgId, environment])
  @@index([orgId, environment, status])
  @@index([orgId, environment, quoteId])
}

// A CONTRACT. `clauses` holds the extracted terms (contract intelligence):
// [{ key, label, value, source? }] — e.g. parties, term dates, renewal notice,
// payment terms. `analyzedAt` marks when the AI analysis ran. Lifecycle:
// draft → active → expiring → expired | terminated. `autoRenew` + renewal
// notice drive the contract.renewal_due alert from the engine ticker.
model Contract {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId            String   @db.ObjectId
  environment      String   @default("production")
  contractNumber   String // per-org ref, e.g. CTR-0001
  name             String
  accountId        String?  @db.ObjectId
  quoteId          String?  @db.ObjectId
  subscriptionId   String?  @db.ObjectId // the recurring contract line (if any)
  status           String   @default("draft") // draft | active | expiring | expired | terminated
  startDate        DateTime?
  endDate          DateTime?
  autoRenew        Boolean  @default(false)
  renewalNoticeDays Int     @default(30)
  clauses          Json     @default("[]") // [{ key, label, value, source? }] — extracted terms
  analyzedAt       DateTime? // when contract intelligence last ran
  createdBy        String   @db.ObjectId
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())

  @@unique([orgId, environment, contractNumber])
  @@index([orgId, environment])
  @@index([orgId, environment, status])
  @@index([orgId, environment, endDate])
}

// A SUBSCRIPTION — the recurring-revenue unit. `mrr` is the monthly recurring
// revenue contribution (unitPrice × quantity ÷ periodMonths), derived at read
// and rolled into the MRR/ARR metrics. The engine ticker advances
// `currentPeriodEnd` and raises invoices; payment failures flip status to
// past_due (dunning). Lifecycle: active → past_due → cancelled | expired.
model Subscription {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId            String   @db.ObjectId
  environment      String   @default("production")
  accountId        String?  @db.ObjectId
  productId        String   @db.ObjectId
  quoteId          String?  @db.ObjectId
  orderId          String?  @db.ObjectId
  name             String // display, e.g. "Northwind — Retail Platform (Annual)"
  billingPeriod    String   @default("monthly") // monthly | quarterly | annual
  unitPrice        Float    @default(0) // per billing period
  quantity         Int      @default(1)
  status           String   @default("active") // active | past_due | cancelled | expired
  startedAt        DateTime @default(now())
  currentPeriodEnd DateTime? // next billing date — ticker advances this
  autoRenew        Boolean  @default(true)
  cancelledAt      DateTime?
  createdBy        String   @db.ObjectId
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())

  @@index([orgId, environment])
  @@index([orgId, environment, status])
  @@index([orgId, environment, accountId])
  @@index([orgId, environment, currentPeriodEnd])
}

// An INVOICE — raised by the engine on subscription renewal or issued from an
// order. Totals derived at read from `lines` (same shape as quotes).
// `dunningAttempts` counts failed collection attempts (the dunning loop).
// Lifecycle: draft → issued → paid → overdue | voided.
model Invoice {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId           String   @db.ObjectId
  environment     String   @default("production")
  invoiceNumber   String // per-org ref, e.g. INV-0001
  accountId       String?  @db.ObjectId
  contactId       String?  @db.ObjectId
  subscriptionId  String?  @db.ObjectId // renewal invoices
  orderId         String?  @db.ObjectId // order invoices
  lines           Json     @default("[]") // [{ productId, productName, sku, quantity, unitPrice, lineTotal }]
  subtotal        Float    @default(0)
  taxTotal        Float    @default(0)
  total           Float    @default(0)
  currency        String   @default("USD")
  status          String   @default("draft") // draft | issued | paid | overdue | voided
  dueDate         DateTime?
  issuedAt        DateTime?
  paidAt          DateTime?
  dunningAttempts Int      @default(0)
  createdBy       String   @db.ObjectId
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  @@unique([orgId, environment, invoiceNumber])
  @@index([orgId, environment])
  @@index([orgId, environment, status])
  @@index([orgId, environment, subscriptionId])
  @@index([orgId, environment, dueDate])
}

// A PAYMENT against an invoice. `refundOf` links a refund to its original
// payment (refunds are payments with status "refunded" + amount). Mock method
// (ADR-014: no real PSP in v1). A succeeded payment settles its invoice
// (invoice.paid); a failed one feeds dunning (payment.failed).
model Payment {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId         String   @db.ObjectId
  environment   String   @default("production")
  invoiceId     String   @db.ObjectId
  accountId     String?  @db.ObjectId
  amount        Float    @default(0)
  method        String   @default("card") // card | bank | other (mock)
  status        String   @default("succeeded") // succeeded | failed | refunded
  failureReason String?
  refundOf      String?  @db.ObjectId // when this payment is a refund of another
  paidAt        DateTime?
  createdBy     String   @db.ObjectId
  createdAt     DateTime @default(now())

  @@index([orgId, environment])
  @@index([orgId, environment, invoiceId])
  @@index([orgId, environment, status])
}

// ── Phase 11 · Customer Success, Retention & Expansion (ADR-023) ───────────
// The "protect and grow existing revenue" phase: success/onboarding plans
// with milestones + QBRs, product usage intelligence (feature adoption, seat
// usage, inactivity), churn prediction v2 (explained, deterministic) +
// expansion/upsell/cross-sell radar, NPS/CSAT/CES surveys with a feedback →
// roadmap pipeline, and loyalty/advocacy programs (referrals, tiers,
// rewards). Everything derives on read from live rows (ADR-018 discipline);
// the engine (server/lib/success.ts) mirrors events into usage, runs
// adoption/inactivity analysis, refreshes churn scores, and detects
// expansion opportunities on a ticker + admin tick.

// An ONBOARDING / SUCCESS PLAN (blueprint entity) for an account, with a
// milestones checklist + QBR log stored as JSON (SlaPolicy/PriceBook
// pattern). kind = onboarding | success | custom; status = draft | active |
// at_risk | completed | archived. The account's Phase 7 health is joined at
// read; low health flips the plan to at_risk (health-score-to-playbook
// mapping, docs/34-customer-success-guide.md).
model SuccessPlan {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production") // ADR-008
  accountId   String?  @db.ObjectId
  name        String
  kind        String   @default("onboarding") // onboarding | success | custom
  status      String   @default("draft") // draft | active | at_risk | completed | archived
  ownerId     String?  @db.ObjectId // CSM / user responsible
  startDate   DateTime?
  targetDate  DateTime?
  milestones  Json     @default("[]") // [{ id, title, dueDate?, status: open|done, completedAt? }]
  qbrs        Json     @default("[]") // [{ id, date, title, attendees, notes }]
  notes       String?
  createdBy   String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([orgId, environment])
  @@index([orgId, environment, accountId])
  @@index([orgId, environment, status])
}

// PRODUCT USAGE TELEMETRY (blueprint entity) — what the customer did INSIDE
// the product (feature used, login, api call, seat added…). Distinct from
// BehaviorEvent (Phase 7, cross-touchpoint behavior): this is product usage
// intelligence — feature adoption, seat usage, inactivity. Two paths: the
// API ingest (POST /api/success/usage — the product posts telemetry) and the
// event-bus mirror (startSuccessEngine maps system events → feature usage,
// exactly like the Phase 7 CDP mirror).
model UsageEvent {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production")
  accountId   String?  @db.ObjectId
  profileId   String?  @db.ObjectId
  contactId   String?  @db.ObjectId
  type        String   @default("feature_used") // feature_used | login | api_call | seat_added | …
  feature     String   @default("general") // feature key: pipelines, email, workflows, ai, tickets, …
  value       Float? // numeric payload (minutes, count)
  meta        Json     @default("{}")
  source      String   @default("api") // api | event-bus | seed
  occurredAt  DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([orgId, environment, accountId, occurredAt])
  @@index([orgId, environment, feature, occurredAt])
  @@index([orgId, environment, profileId])
}

// A SURVEY (blueprint entity) — NPS (0–10), CSAT (1–5), CES (1–7). Responses
// record the score + optional comment; sentiment is derived at read
// (transparent keyword analysis, ADR-020 discipline). Negative feedback can
// be promoted into the ROADMAP pipeline (RoadmapItem) — the blueprint's
// "feedback → roadmap pipeline".
model Survey {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId           String   @db.ObjectId
  environment     String   @default("production")
  name            String
  kind            String   @default("nps") // nps | csat | ces
  question        String
  active          Boolean  @default(true)
  targetSegmentId String?  @db.ObjectId // Phase 1 segment audience (optional)
  createdBy       String   @db.ObjectId
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now())

  @@index([orgId, environment])
}

// One survey response. `score` is validated per kind (nps 0–10, csat 1–5,
// ces 1–7). `sentiment` is derived at read; a negative comment can be
// promoted to a RoadmapItem (feedback → roadmap).
model SurveyResponse {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production")
  surveyId    String   @db.ObjectId
  profileId   String?  @db.ObjectId
  contactId   String?  @db.ObjectId
  accountId   String?  @db.ObjectId
  score       Int // nps 0-10 | csat 1-5 | ces 1-7
  comment     String?
  sentiment   String? // positive | neutral | negative (derived at read)
  respondedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([orgId, environment, surveyId])
  @@index([orgId, environment, respondedAt])
}

// The FEEDBACK → ROADMAP pipeline (blueprint) — a roadmap item can be created
// directly (source: internal/feedback) or promoted from a survey comment
// (source: survey + surveyResponseId). status = new | triaged | planned |
// in_progress | shipped | declined; votes prioritize the backlog.
model RoadmapItem {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId            String   @db.ObjectId
  environment      String   @default("production")
  title            String
  description      String?
  source           String   @default("internal") // survey | feedback | internal
  status           String   @default("new") // new | triaged | planned | in_progress | shipped | declined
  category         String   @default("improvement") // feature | improvement | bug | other
  votes            Int      @default(0)
  surveyResponseId String?  @db.ObjectId // when promoted from a survey comment
  createdBy        String   @db.ObjectId
  createdAt        DateTime @default(now())
  updatedAt        DateTime @default(now())

  @@index([orgId, environment, status])
}

// A LOYALTY / ADVOCACY PROGRAM (blueprint entity) — config is JSON
// (SlaPolicy/PriceBook pattern): tiers [{ key, name, minPoints, benefits }],
// rewards [{ key, name, pointsCost, description }], pointsRules { referral:
// 500, survey: 50, review: 100, … }.
model LoyaltyProgram {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production")
  name        String
  active      Boolean  @default(true)
  tiers       Json     @default("[]") // [{ key, name, minPoints, benefits }]
  rewards     Json     @default("[]") // [{ key, name, pointsCost, description }]
  pointsRules Json     @default("{}") // { referral: 500, survey: 50, review: 100 }
  createdBy   String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([orgId, environment])
}

// MEMBERSHIP — one row per customer per program, with a points ledger. Tier
// is DERIVED at read from points against the program's tier bands
// (docs/34-customer-success-guide.md loyalty rules). One member per
// program × contact (enforced in the service layer — Mongo nulls are not
// unique-safe).
model LoyaltyMember {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production")
  programId   String   @db.ObjectId
  profileId   String?  @db.ObjectId
  contactId   String?  @db.ObjectId
  accountId   String?  @db.ObjectId
  points      Int      @default(0)
  joinedAt    DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([orgId, environment, programId])
  @@index([orgId, environment, contactId])
}

// A REFERRAL (blueprint entity) — a member refers a business email.
// Lifecycle pending → contacted → converted (points awarded to the referrer
// per the program's pointsRules.referral) | expired. Conversion can be
// declared manually or detected by the engine (the referred contact becomes
// a customer).
model ReferralRecord {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId             String   @db.ObjectId
  environment       String   @default("production")
  programId         String   @db.ObjectId
  referrerContactId String?  @db.ObjectId
  referrerProfileId String?  @db.ObjectId
  referredEmail     String
  referredName      String?
  status            String   @default("pending") // pending | contacted | converted | expired
  pointsAwarded     Int      @default(0)
  convertedAt       DateTime?
  createdBy         String   @db.ObjectId
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now())

  @@index([orgId, environment, programId])
  @@index([orgId, environment, status])
}

// PERSISTED CHURN PREDICTION (v2 — explained, deterministic; blueprint event
// churn.risk_scored). The prediction is COMPUTED at read from Phase 7 health
// + usage trend + support + billing + survey signals; an admin refresh (or
// the engine ticker) persists one ChurnScore per account × refreshId so the
// UI has history + deltas, and churn.risk_scored fires when the tier
// escalates (docs/34-customer-success-guide.md churn model).
model ChurnScore {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId         String   @db.ObjectId
  environment   String   @default("production")
  accountId     String?  @db.ObjectId
  score         Int      @default(0) // 0-100 churn probability
  riskTier      String   @default("low") // low | medium | high | critical
  factors       Json     @default("[]") // [{ key, label, impact, detail }] — the explanation
  inputs        Json     @default("{}") // raw model inputs
  refreshId     String?
  previousScore Int?
  createdAt     DateTime @default(now())

  @@index([orgId, environment, accountId, createdAt])
  @@index([orgId, environment, refreshId])
}

// ── PHASE 12 · FIELD OPERATIONS (blueprint entities) ───────────────────────
// Territory / Technician / Visit / WorkOrder / Asset / InventoryItem — the
// physical-world loop: territories own accounts + technicians, technicians
// run visits (GPS check-ins) and work orders (dispatch → SLA → completion),
// assets carry warranty + maintenance schedules, inventory tracks stock with
// reorder levels. Every row is org × environment scoped (ADR-008) and every
// state change is evented (`visit.checked_in`, `workorder.completed`,
// `asset.maintenance_due`, …). All logic lives in lib/field.ts (ADR-015/017
// row-as-config pattern: the engine + routes are the only code).

// A sales/service TERRITORY (blueprint entity) — a named geography that owns
// accounts + technicians. accountIds are the assigned accounts; a manager
// (ownerId) runs it.
model Territory {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production") // ADR-008
  name        String
  region      String? // free-text region ("Northeast", "EMEA"…)
  ownerId     String?  @db.ObjectId // territory manager (User)
  accountIds  Json     @default("[]") // assigned account ids
  active      Boolean  @default(true)
  notes       String?
  createdBy   String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([orgId, environment])
}

// A FIELD TECHNICIAN (blueprint entity) — a person in the field. userId links
// a platform user; skills are a JSON list; status = available | on_route |
// off_duty; lat/lng is the last reported GPS position (check-ins + route
// optimization use it).
model Technician {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production")
  name        String
  userId      String?  @db.ObjectId // linked platform user (optional)
  territoryId String?  @db.ObjectId
  phone       String?
  skills      Json     @default("[]") // ["install", "repair", "network"]
  status      String   @default("available") // available | on_route | off_duty
  lat         Float?
  lng         Float?
  createdBy   String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([orgId, environment])
  @@index([orgId, environment, territoryId])
}

// A planned field VISIT (blueprint entity) — a technician visits an account
// (or contact) at a scheduled time. status = planned | in_transit |
// checked_in | completed | cancelled; a GPS check-in records checkInAt +
// checkInLat/Lng (visit.checked_in). Route planning reorders planned visits
// by proximity to the technician's last position.
model Visit {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId        String   @db.ObjectId
  environment String   @default("production")
  territoryId String?  @db.ObjectId
  accountId   String?  @db.ObjectId
  contactId   String?  @db.ObjectId
  technicianId String? @db.ObjectId
  title       String
  scheduledAt DateTime
  status      String   @default("planned") // planned | in_transit | checked_in | completed | cancelled
  checkInAt   DateTime?
  checkInLat  Float?
  checkInLng  Float?
  notes       String?
  createdBy   String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([orgId, environment])
  @@index([orgId, environment, technicianId])
  @@index([orgId, environment, scheduledAt])
}

// A field-service WORK ORDER (blueprint entity) — a job for a technician.
// status = open | dispatched | in_progress | on_hold | completed | cancelled;
// slaDueAt is the field-service SLA deadline (a breach sweep fires
// workorder.sla_breached + notifies admins). completedAt + partsUsed (JSON
// [{sku, qty}]) drive inventory consumption.
model WorkOrder {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId        String   @db.ObjectId
  environment  String   @default("production")
  territoryId  String?  @db.ObjectId
  accountId    String?  @db.ObjectId
  assetId      String?  @db.ObjectId // the asset being serviced
  technicianId String? @db.ObjectId
  title        String
  description  String?
  priority     String   @default("medium") // low | medium | high | critical
  status       String   @default("open") // open | dispatched | in_progress | on_hold | completed | cancelled
  slaDueAt     DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  partsUsed    Json     @default("[]") // [{ sku, qty }] — inventory consumption
  notes        String?
  createdBy    String   @db.ObjectId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  @@index([orgId, environment])
  @@index([orgId, environment, status])
  @@index([orgId, environment, technicianId])
}

// A customer ASSET (blueprint entity) — a serialized unit under warranty with
// a maintenance schedule. status = active | maintenance | retired;
// maintenance is due when lastMaintenanceAt + maintenanceIntervalDays < now
// (the engine ticker fires asset.maintenance_due once per cycle).
model Asset {
  id                      String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId                   String   @db.ObjectId
  environment             String   @default("production")
  accountId               String?  @db.ObjectId
  name                    String
  serialNumber            String?
  type                    String? // hardware | software | vehicle | …
  status                  String   @default("active") // active | maintenance | retired
  warrantyUntil           DateTime?
  lastMaintenanceAt       DateTime?
  maintenanceIntervalDays Int?
  location                String?
  notes                   String?
  createdBy               String   @db.ObjectId
  createdAt               DateTime @default(now())
  updatedAt               DateTime @default(now())

  @@index([orgId, environment])
  @@index([orgId, environment, accountId])
}

// An INVENTORY item (blueprint entity) — tracked stock with a reorder level.
// quantityOnHand moves via receive/consume (work-order partsUsed deducts);
// at/below reorderLevel the ticker fires inventory.reorder_triggered once
// per cycle.
model InventoryItem {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId          String   @db.ObjectId
  environment    String   @default("production")
  sku            String
  name           String
  quantityOnHand Int      @default(0)
  reorderLevel   Int      @default(0)
  unitCost       Float    @default(0)
  location       String? // warehouse / bin
  notes          String?
  createdBy      String   @db.ObjectId
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())

  @@index([orgId, environment])
}

// ── PHASE 13 · ECOSYSTEM (blueprint entities) ──────────────────────────────
// App / MarketplaceListing / PartnerAccount / ChangeSet — the extensibility
// loop: a catalog of pre-built apps/agents/integrations (MarketplaceListing)
// that an org installs (App, app.installed), partners with deal registration
// + commissions (PartnerAccount), and config promotion between environments
// via change sets (ChangeSet, changeset.promoted) — plus the schema
// change-impact analysis surface (docs/43-schema-change-safety.md). Every
// row is org × environment scoped (ADR-008) and every lifecycle event is
// evented. All logic lives in lib/ecosystem.ts (ADR-015/017 row-as-config).

// A MARKETPLACE LISTING (blueprint entity) — a published, installable
// pre-built app/agent/integration/template. The catalog is platform-seeded
// (seed.ts) and admin-extensible; installing creates an `App` row and applies
// the listing's `config` (agent templates via the Phase 9 engine, webhooks,
// feature-flag hints, …).
model MarketplaceListing {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production")
  slug        String // stable id, e.g. "lead-agent"
  name        String
  kind        String   @default("app") // app | agent | integration | template
  description String?
  publisher   String
  version     String   @default("1.0.0")
  icon        String?
  config      Json     @default("{}") // install payload: { agentTemplate?, webhookEvents?, flags? }
  active      Boolean  @default(true)
  installCount Int     @default(0)
  createdBy   String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([orgId, environment])
  @@unique([orgId, environment, slug])
}

// An installed APP (blueprint entity) — one row per org × environment per
// listing the org has installed. `config` holds the runtime settings the
// install applied (installed agent ids, webhook id, flags). Uninstall
// deactivates the row (status: uninstalled) rather than deleting, keeping
// the audit trail.
model App {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production")
  listingId   String?  @db.ObjectId // the marketplace listing it came from (null for custom apps)
  slug        String
  name        String
  kind        String   @default("app") // app | agent | integration | template
  status      String   @default("installed") // installed | uninstalled
  config      Json     @default("{}")
  installedBy String   @db.ObjectId
  installedAt DateTime @default(now())
  updatedAt   DateTime @default(now())
  uninstalledAt DateTime?

  @@index([orgId, environment])
  @@unique([orgId, environment, slug])
}

// A PARTNER ACCOUNT (blueprint entity) — a reseller / referral / technology
// partner. Deal registration (co-selling) tracks opportunities a partner
// helped source; commissions are derived at read from won registered deals ×
// the partner's rate. Partner lifecycle + registrations are evented
// (`partner.deal_registered`, `partner.commission_earned`).
model PartnerAccount {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId         String   @db.ObjectId
  environment   String   @default("production")
  name          String
  type          String   @default("reseller") // reseller | referral | technology | consultant
  contactName   String?
  email         String?
  phone         String?
  commissionRate Float   @default(0.1) // 0.10 = 10% of won deal amount
  status        String   @default("active") // active | inactive
  notes         String?
  createdBy     String   @db.ObjectId
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())

  @@index([orgId, environment])
}

// A registered partner DEAL (blueprint entity) — a partner-sourced opportunity.
// status = registered | approved | won | lost; commission = amount × rate when
// won (derived at read; the event fires on the status change to won).
model PartnerDeal {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production")
  partnerId   String   @db.ObjectId
  opportunityId String? @db.ObjectId // linked deal (optional — partner deals can precede the CRM deal)
  name        String
  amount      Float    @default(0)
  status      String   @default("registered") // registered | approved | won | lost
  registeredAt DateTime @default(now())
  wonAt       DateTime?
  createdBy   String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([orgId, environment])
  @@index([orgId, environment, partnerId])
}

// A CHANGE SET (blueprint entity) — a bundle of configuration/schema changes
// (FieldDef rows, agents, feature flags, …) captured in one environment and
// promotable to another (dev → staging → prod). Each item is
// `{ entity, op: create|update|delete, key, data }`; promote replays the
// items in the target environment and records the result. Emits
// `changeset.promoted` (blueprint event).
model ChangeSet {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production") // the source environment
  name        String
  description String?
  items       Json     @default("[]") // [{ entity, op, key, data }]
  status      String   @default("draft") // draft | promoted | failed
  fromEnv     String?
  toEnv       String?
  promotedBy  String?
  promotedAt  DateTime?
  error       String?
  createdBy   String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([orgId, environment])
}

// ─────────────────────────────────────────────────────────────────────────────
// Phase 14 — Enterprise Security, Compliance & Governance
// (spec docs/44-spec-phase14.md, ADR-026)
// ─────────────────────────────────────────────────────────────────────────────

// DB-backed sessions — the Phase 14 upgrade from signed cookies. Every login
// (password, SSO) issues a row; the cookie payload embeds the session id and
// loadSession checks the row (revoked/expired). Device management = these rows.
model SecuritySession {
  id         String    @id @default(auto()) @map("_id") @db.ObjectId
  orgId      String    @db.ObjectId
  userId     String    @db.ObjectId
  device     String? // browser / OS label (user-agent)
  ip         String? // the IP the session was issued from
  location   String? // derived label (e.g. "Local network" or geo guess)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  expiresAt  DateTime
  revokedAt  DateTime?

  @@index([orgId, userId])
  @@index([orgId, createdAt])
}

// Security alerts — the blueprint entity. Raised by the engine + policy
// enforcement (threats, MFA gaps, breached SLAs) and surface in the UI.
model SecurityAlert {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId          String   @db.ObjectId
  environment    String   @default("production")
  severity       String   @default("medium") // info | low | medium | high | critical
  category       String   // auth | mfa | session | ip | scim | consent | retention | status | encryption
  title          String
  message        String
  details        Json     @default("{}")
  acknowledgedAt DateTime?
  createdBy      String   @default("system")
  createdAt      DateTime @default(now())

  @@index([orgId, environment, createdAt])
}

// Consent records — the blueprint entity. Purposes: marketing / analytics /
// processing / communications. Every transition emits consent.updated.
model ConsentRecord {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  environment String   @default("production")
  contactId   String?  @db.ObjectId
  contactEmail String? // denormalized for subject lookup + DSR resolution
  purpose     String // marketing | analytics | processing | communications
  status      String   @default("pending") // granted | withdrawn | pending
  source      String   @default("manual") // form | portal | dsr | api | manual
  grantedAt   DateTime?
  withdrawnAt DateTime?
  expiresAt   DateTime?
  meta        Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([orgId, contactId])
  @@index([orgId, contactEmail])
}

// Data subject requests (GDPR/CCPA) — access / export / delete / rectify.
model DataSubjectRequest {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId          String   @db.ObjectId
  environment    String   @default("production")
  type           String // access | export | delete | rectify
  status         String   @default("open") // open | processing | completed | rejected
  requesterEmail String
  contactId      String?  @db.ObjectId
  contactEmail   String?
  submittedAt    DateTime @default(now())
  completedAt    DateTime?
  notes          String?
  meta           Json     @default("{}")
  createdBy      String?  @db.ObjectId

  @@index([orgId, status])
}

// Retention policies — the blueprint entity. A scan (engine ticker + manual
// run) applies older-than rules: delete records or anonymize their PII.
model RetentionPolicy {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId        String   @db.ObjectId
  environment  String   @default("production")
  name         String
  entity       String // contact | lead | account | opportunity | ticket | call | meeting
  olderThanDays Int
  action       String   @default("delete") // delete | anonymize
  status       String   @default("active") // active | paused
  lastRunAt    DateTime?
  lastProcessed Int      @default(0)
  createdBy    String   @db.ObjectId
  createdAt    DateTime @default(now())
  updatedAt    DateTime @default(now())

  @@index([orgId, environment])
}

// Vendor / sub-processor transparency — the 🆕 blueprint item.
model SubProcessor {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId        String   @db.ObjectId
  name         String
  purpose      String
  region       String
  dataCategories Json   @default("[]")
  link         String?
  status       String   @default("active") // active | retired | pending
  updatedAt    DateTime @default(now())

  @@index([orgId])
}

// Status page — admin-managed incidents (public view optional).
model StatusIncident {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  component   String   @default("api") // api | webhooks | email | app
  title       String
  severity    String   @default("minor") // minor | major | critical
  status      String   @default("investigating") // investigating | identified | monitoring | resolved
  message     String
  startedAt   DateTime @default(now())
  resolvedAt  DateTime?
  updates     Json     @default("[]")
  createdBy   String   @db.ObjectId
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([orgId, status])
}

// Uptime monitor ticks — the status engine pings service components and
// records up/degraded/down so the dashboard derives real uptime %.
model UptimeEvent {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  component   String   @default("api")
  status      String   @default("up") // up | degraded | down
  latencyMs   Int?
  message     String?
  checkedAt   DateTime @default(now())

  @@index([orgId, component, checkedAt])
}

// SCIM 2.0 groups — provisioning groups whose members map to org users
// (displayName in admin | manager | rep sets each member's role).
model ScimGroup {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  externalId  String   @unique
  displayName String
  role        String // admin | manager | rep — applied to members
  memberIds   Json     @default("[]") // user ids
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())

  @@index([orgId])
}

// i18n — org translation catalog + localization QA (translation completeness).
model TranslationEntry {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  orgId       String   @db.ObjectId
  locale      String   @default("en")
  key         String
  source      String   @default("app") // app | custom
  value       String
  status      String   @default("translated") // translated | missing | untranslated
  updatedAt   DateTime @default(now())

  @@unique([orgId, locale, key])
}

